@page "/modules/{ModuleId:int}/avatar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IApiClient Api
@inject IJSRuntime JS

<PageTitle>Session Formateur IA</PageTitle>

<div class="avatar-session-container">
    <div class="avatar-header">
        <h2>🤖 Session avec le Formateur IA</h2>
        @if (_session != null) { <span class="badge @(_session.IsMockMode ? "badge-warning" : "badge-success")">@(_session.IsMockMode ? "Mode démo" : "Anam.ai connecté")</span> }
    </div>

    @if (_isStarting)
    {
        <div class="avatar-loading">
            <div class="avatar-placeholder">
                <div class="avatar-ripple"></div>
                <span class="avatar-emoji">🤖</span>
            </div>
            <p>Connexion au formateur IA en cours...</p>
        </div>
    }
    else if (_session != null)
    {
        <div class="avatar-layout">
            <div class="avatar-video-panel">
                @if (_session.IsMockMode)
                {
                    <div class="avatar-mock-player">
                        <div class="mock-avatar-animation">
                            <div class="avatar-face">🤖</div>
                            @if (_isSpeaking) { <div class="speaking-indicator"><span></span><span></span><span></span></div> }
                        </div>
                        <div class="mock-status">@(_isSpeaking ? "En train de parler..." : "En attente de votre question")</div>
                    </div>
                }
                else
                {
                    <iframe src="@_session.StreamUrl" class="avatar-iframe"
                            allow="camera; microphone; autoplay"
                            allowfullscreen></iframe>
                }
            </div>

            <div class="avatar-chat-panel">
                <div class="chat-messages" id="chat-messages">
                    @foreach (var msg in _messages)
                    {
                        <div class="chat-message @msg.Role">
                            <div class="message-bubble">@msg.Content</div>
                            <div class="message-time">@msg.Timestamp.ToString("HH:mm")</div>
                        </div>
                    }
                    @if (_isTyping)
                    {
                        <div class="chat-message assistant">
                            <div class="message-bubble typing-indicator"><span></span><span></span><span></span></div>
                        </div>
                    }
                </div>

                <div class="chat-input-bar">
                    <input type="text" @bind="_userMessage" @onkeyup="HandleKeyUp"
                           placeholder="Posez votre question au formateur IA..."
                           class="chat-input" disabled="@(_isTyping)" />
                    <button class="btn btn-primary" @onclick="SendMessageAsync" disabled="@(_isTyping || string.IsNullOrWhiteSpace(_userMessage))">
                        ➤
                    </button>
                </div>
            </div>
        </div>

        <div class="session-actions">
            <button class="btn btn-danger" @onclick="EndSessionAsync">Terminer la session</button>
        </div>
    }
    else if (_hasError)
    {
        <div class="alert alert-error">
            Impossible de démarrer la session IA. Vérifiez votre connexion ou réessayez plus tard.
        </div>
    }
</div>

@code {
    [Parameter] public int ModuleId { get; set; }

    private StartSessionResponse? _session;
    private bool _isStarting = true;
    private bool _hasError;
    private bool _isTyping;
    private bool _isSpeaking;
    private string _userMessage = "";
    private List<ChatMsg> _messages = [];
    private DateTime _sessionStart = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _session = await Api.PostAsync<object, StartSessionResponse>(
                "api/avatar/sessions/start",
                new { ModuleId });

            if (_session == null) { _hasError = true; }
            else
            {
                _messages.Add(new ChatMsg("assistant",
                    "Bonjour ! Je suis votre formateur IA. Comment puis-je vous aider avec ce module ?",
                    DateTime.Now));
            }
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _isStarting = false;
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_userMessage) || _session == null) return;

        var msg = _userMessage.Trim();
        _userMessage = "";
        _messages.Add(new ChatMsg("user", msg, DateTime.Now));
        _isTyping = true;
        _isSpeaking = false;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var response = await Api.PostAsync<object, SendMessageResponse>(
                "api/avatar/sessions/message",
                new { SessionId = _session.SessionId, DbSessionId = _session.DbSessionId, Message = msg });

            if (response != null)
            {
                _messages.Add(new ChatMsg("assistant", response.AvatarResponse, DateTime.Now));
                _isSpeaking = true;
                await Task.Delay(2000);
                _isSpeaking = false;
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMsg("system", "Erreur de communication avec le formateur IA.", DateTime.Now));
        }
        finally
        {
            _isTyping = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessageAsync();
    }

    private async Task EndSessionAsync()
    {
        if (_session == null) return;
        var duree = (int)(DateTime.Now - _sessionStart).TotalSeconds;
        await Api.PostAsync<object, object>(
            $"api/avatar/sessions/{_session.DbSessionId}/end",
            new { DureeSecondes = duree });
        _session = null;
    }

    private async Task ScrollToBottom()
        => await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");

    record ChatMsg(string Role, string Content, DateTime Timestamp);
    record StartSessionResponse(string SessionId, string? StreamUrl, string? EmbedToken, bool IsMockMode, int DbSessionId);
    record SendMessageResponse(string AvatarResponse, string? AudioUrl, string? VideoStreamUrl);
}
