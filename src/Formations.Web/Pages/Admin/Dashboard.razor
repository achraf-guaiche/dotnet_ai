@page "/admin/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IApiClient Api

<PageTitle>Administration — Dashboard</PageTitle>

<div class="admin-header">
    <h1>Dashboard Administration</h1>
    <span class="badge badge-admin">Admin</span>
</div>

@if (_stats == null)
{
    <div class="loading-spinner"><div class="spinner"></div></div>
}
else
{
    <div class="stats-grid">
        <div class="stat-widget">
            <div class="widget-icon blue">📚</div>
            <div class="widget-body">
                <div class="widget-value">@_stats.TotalFormations</div>
                <div class="widget-label">Formations</div>
                <div class="widget-sub">@_stats.FormationsPubliees publiées</div>
            </div>
        </div>
        <div class="stat-widget">
            <div class="widget-icon green">👥</div>
            <div class="widget-body">
                <div class="widget-value">@_stats.TotalApprenants</div>
                <div class="widget-label">Apprenants</div>
            </div>
        </div>
        <div class="stat-widget">
            <div class="widget-icon purple">🎓</div>
            <div class="widget-body">
                <div class="widget-value">@_stats.TotalFormateurs</div>
                <div class="widget-label">Formateurs</div>
            </div>
        </div>
        <div class="stat-widget">
            <div class="widget-icon orange">📈</div>
            <div class="widget-body">
                <div class="widget-value">@_stats.TauxCompletionMoyen%</div>
                <div class="widget-label">Taux completion</div>
            </div>
        </div>
    </div>

    <div class="admin-grid">
        <div class="admin-card">
            <h3>Top Formations</h3>
            <table class="data-table">
                <thead><tr><th>Formation</th><th>Inscrits</th><th>Complétion</th></tr></thead>
                <tbody>
                    @foreach (var f in _stats.TopFormations)
                    {
                        <tr>
                            <td>@f.Titre</td>
                            <td>@f.NbInscrits</td>
                            <td>
                                <div class="progress-bar-mini">
                                    <div class="progress-fill" style="width: @f.TauxCompletion%"></div>
                                </div>
                                @f.TauxCompletion%
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-card">
            <h3>Inscriptions récentes</h3>
            <ul class="activity-list">
                @foreach (var i in _stats.RecentesInscriptions)
                {
                    <li class="activity-item">
                        <span class="activity-icon">📝</span>
                        <div class="activity-body">
                            <strong>@i.UserFullName</strong> s'est inscrit à <em>@i.FormationTitre</em>
                        </div>
                        <span class="activity-time">@i.Date.ToString("dd/MM HH:mm")</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="admin-nav-cards">
        <a href="/admin/utilisateurs" class="admin-nav-card">👤 Gérer les utilisateurs</a>
        <a href="/admin/formations" class="admin-nav-card">📚 Gérer les formations</a>
        <a href="/admin/categories" class="admin-nav-card">🏷️ Gérer les catégories</a>
        <a href="/admin/formateurs" class="admin-nav-card">🎓 Gérer les formateurs</a>
        <a href="/admin/logs" class="admin-nav-card">📋 Logs d'activité</a>
    </div>
}

@code {
    private DashboardStats? _stats;

    protected override async Task OnInitializedAsync()
        => _stats = await Api.GetAsync<DashboardStats>("api/admin/dashboard");

    record DashboardStats(int TotalFormations, int TotalApprenants, int TotalFormateurs, int TotalInscriptions,
        decimal TauxCompletionMoyen, int FormationsPubliees, List<FormationStat> TopFormations, List<InscriptionRecente> RecentesInscriptions);
    record FormationStat(int Id, string Titre, int NbInscrits, decimal TauxCompletion);
    record InscriptionRecente(string UserFullName, string FormationTitre, DateTime Date);
}
