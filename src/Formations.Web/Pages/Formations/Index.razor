@page "/formations"
@inject FormationWebService FormationService

<PageTitle>Toutes les formations</PageTitle>

<div class="page-header">
    <h1>Nos formations</h1>
    <p>@(_formations?.TotalCount ?? 0) formation(s) disponible(s)</p>
</div>

<div class="filters-bar">
    <input type="search" placeholder="Rechercher..." @bind="_search" @bind:event="oninput"
           @onkeyup="SearchDebounced" class="search-input" />

    <select @onchange="OnCategorieChanged" class="filter-select">
        <option value="">Toutes les catégories</option>
        @if (_categories != null)
        {
            @foreach (var cat in _categories)
            {
                <option value="@cat.Id">@cat.Icone @cat.Nom</option>
            }
        }
    </select>
</div>

@if (_isLoading)
{
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Chargement des formations...</p>
    </div>
}
else if (_formations?.Items.Any() == true)
{
    <div class="formations-grid">
        @foreach (var f in _formations.Items)
        {
            <FormationCard Formation="f" />
        }
    </div>

    @if (_formations.TotalPages > 1)
    {
        <div class="pagination">
            <button class="btn btn-outline" @onclick="PreviousPage" disabled="@(_page == 1)">← Précédent</button>
            <span>Page @_page / @_formations.TotalPages</span>
            <button class="btn btn-outline" @onclick="NextPage" disabled="@(_page >= _formations.TotalPages)">Suivant →</button>
        </div>
    }
}
else
{
    <div class="empty-state">
        <span class="empty-icon">📚</span>
        <p>Aucune formation trouvée pour ces critères.</p>
    </div>
}

@code {
    [SupplyParameterFromQuery] public int? CategorieId { get; set; }

    private FormationsPage? _formations;
    private List<CategorieItem>? _categories;
    private string _search = "";
    private int? _selectedCategorieId;
    private int _page = 1;
    private bool _isLoading = true;
    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        _selectedCategorieId = CategorieId;
        _categories = await FormationService.GetCategoriesAsync();
        await LoadFormationsAsync();
    }

    private async Task LoadFormationsAsync()
    {
        _isLoading = true;
        StateHasChanged();
        _formations = await FormationService.GetFormationsAsync(_page, 12, _selectedCategorieId, _search);
        _isLoading = false;
    }

    private void SearchDebounced()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _page = 1;
            await InvokeAsync(async () => { await LoadFormationsAsync(); StateHasChanged(); });
            _debounceTimer?.Dispose();
        };
        _debounceTimer.Start();
    }

    private async Task OnCategorieChanged(ChangeEventArgs e)
    {
        _selectedCategorieId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!);
        _page = 1;
        await LoadFormationsAsync();
    }

    private async Task PreviousPage() { _page--; await LoadFormationsAsync(); }
    private async Task NextPage() { _page++; await LoadFormationsAsync(); }
}
