# ============================================================
# PLATEFORME FORMATIONS — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer le fichier .env
# ============================================================

# --- Base de données MySQL ---
MYSQL_ROOT_PASSWORD=RootPasswordFort!
MYSQL_DATABASE=formations_db
MYSQL_USER=formations_user
MYSQL_PASSWORD=UserPasswordFort!
ConnectionStrings__Default=server=localhost;port=3306;database=formations_db;user=formations_user;password=UserPasswordFort!;AllowPublicKeyRetrieval=true;SslMode=none

# --- JWT ---
Jwt__Key=VOTRE_CLE_JWT_SECRETE_MINIMUM_32_CARACTERES_ALPHANUMERIQUE
Jwt__Issuer=FormationsPlatform
Jwt__Audience=FormationsUsers
Jwt__AccessTokenExpirationMinutes=60
Jwt__RefreshTokenExpirationDays=30

# --- Avatar IA — Anam.ai ---
# Choisir UN seul provider (Anam.ai recommandé)
AvatarIA__Provider=anam          # anam | heygen | mock
AvatarIA__ApiKey=VOTRE_CLE_ANAM_AI
AvatarIA__PersonaId=VOTRE_PERSONA_ID_ANAM
AvatarIA__BaseUrl=https://api.anam.ai/v1

# --- HeyGen (fallback si Anam.ai non disponible) ---
# AvatarIA__Provider=heygen
# AvatarIA__ApiKey=VOTRE_CLE_HEYGEN
# AvatarIA__AvatarId=VOTRE_AVATAR_ID_HEYGEN

# --- LLM pour le dialogue IA (Claude API) ---
LLM__Provider=claude
LLM__ApiKey=VOTRE_CLE_ANTHROPIC
LLM__Model=claude-sonnet-4-6
LLM__BaseUrl=https://api.anthropic.com

# --- Email (SMTP) ---
Email__Host=smtp.gmail.com
Email__Port=587
Email__UseSsl=true
Email__Username=votre.email@gmail.com
Email__Password=VOTRE_MOT_DE_PASSE_APPLICATION
Email__From=noreply@votre-plateforme.com
Email__FromName=Plateforme Formations

# --- Application ---
App__BaseUrl=https://localhost:5001
App__AllowedHosts=*
App__Environment=Development

# --- Logging ---
Serilog__MinimumLevel=Information
